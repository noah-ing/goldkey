{
  "name": "goldkey-agent-utility-pass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "NODE_ENV=development node --watch src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:enforcer": "npm --prefix enforcer test",
    "test:contract": "forge test --root contracts -vv",
    "fmt:contract": "forge fmt --root contracts",
    "check": "npm run test:contract && npm test && npm run test:enforcer",
    "deployment:create2": "node scripts/build-create2-deployment.mjs",
    "deployment:create2:dry-run": "node scripts/build-create2-deployment.mjs --sample-sepolia",
    "demo": "node scripts/demo.mjs",
    "seller": "node scripts/seller-loop.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/extensions": "2.21.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "express": "5.2.1",
    "pg": "8.22.0",
    "viem": "2.55.13"
  }
}
