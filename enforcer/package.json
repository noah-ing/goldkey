    "agentcash": "0.17.1",
    "viem": "2.55.13",
    "yaml": "2.9.0"
  },
  "scripts": {
    "pack:integrity": "node scripts/pack-integrity.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "main": "./src/index.mjs",
  "directories": {
    "test": "test"
