    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./adapters/runtime": "./src/adapters/runtime.mjs",
    "./adapters/runtime-factory": "./src/adapters/runtime-factory.mjs",
    "./adapters/mcp-stdio-config": "./src/adapters/mcp-stdio-config.mjs",
    "./adapters/mcp-stdio-launcher": "./src/adapters/mcp-stdio-launcher.mjs",
    "./adapters/agentcash": "./src/adapters/agentcash-mcp.mjs",
    "./adapters/agentcash-server": "./src/adapters/agentcash-mcp-server.mjs",
    "./adapters/base-wallet": "./src/adapters/base-wallet.mjs",
    "./adapters/base-wallet-config": "./src/adapters/base-wallet-config.mjs",
    "./adapters/base-wallet-request": "./src/adapters/base-wallet-request.mjs",
    "./adapters/base-wallet-signer": "./src/adapters/base-wallet-signer.mjs",
    "./adapters/base-wallet-mcp": "./src/adapters/base-wallet-mcp.mjs"
  },
  "bin": {
    "goldkey-mcp-stdio": "./bin/goldkey-mcp-stdio.mjs",
    "goldkey-agentcash": "./bin/goldkey-agentcash.mjs",
    "goldkey-wallet": "./bin/goldkey-wallet.mjs",
    "goldkey-wallet-mcp": "./bin/goldkey-wallet-mcp.mjs"
